{
  "name": "yunxiao-agent-vscode",
  "displayName": "云效 Agent",
  "publisher": "yunxiao",
  "repository": {
    "type": "git",
    "url": "https://github.com/gjw-rx/yunxiao.git"
  },
  "description": "码力云效-对接自有ai服务",
  "version": "0.1.2",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yunxiaoAgentContainer",
          "title": "云效 Agent",
          "icon": "media/icon-view.svg"
        }
      ]
    },
    "views": {
      "yunxiaoAgentContainer": [
        {
          "type": "webview",
          "id": "yunxiaoAgent.chatView",
          "name": "对话面板",
          "icon": "media/icon-view.svg",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "yunxiaoAgent.openPanel",
        "title": "云效 Agent: 打开对话面板"
      },
      {
        "command": "yunxiaoAgent.newSession",
        "title": "云效 Agent: 新建会话",
        "icon": "$(add)"
      }
    ],
    "configuration": {
      "title": "云效 Agent",
      "properties": {
        "yunxiaoAgent.model.provider": {
          "type": "string",
          "default": "openai",
          "description": "LLM Provider ID（如 openai，兼容 DeepSeek/通义千问等 OpenAI 兼容服务）",
          "scope": "window"
        },
        "yunxiaoAgent.model.model": {
          "type": "string",
          "default": "",
          "description": "模型名称（如 gpt-4o-mini、deepseek-chat）",
          "scope": "window"
        },
        "yunxiaoAgent.model.apiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API Key（Bearer Token）",
          "scope": "window"
        },
        "yunxiaoAgent.model.baseURL": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "LLM API 地址（OpenAI 兼容的 /v1/chat/completions 端点）",
          "scope": "window"
        },
        "yunxiaoAgent.model.temperature": {
          "type": "number",
          "default": 0.7,
          "description": "LLM 生成温度参数",
          "scope": "window"
        },
        "yunxiaoAgent.model.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "LLM 最大输出 token 数",
          "scope": "window"
        },
        "yunxiaoAgent.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "fs.read_file 读取文件大小上限（字节），作为分页读取的护栏，默认 1MB",
          "scope": "window"
        },
        "yunxiaoAgent.readFile.maxLines": {
          "type": "number",
          "default": 2000,
          "description": "fs.read_file 单页最大行数（默认 2000），配合 offset 分页续读",
          "scope": "window"
        },
        "yunxiaoAgent.readFile.maxBytes": {
          "type": "number",
          "default": 51200,
          "description": "fs.read_file 单页累计字节预算（默认 50KB），超过即停止并提示 offset 续读",
          "scope": "window"
        },
        "yunxiaoAgent.readFile.maxLineLength": {
          "type": "number",
          "default": 2000,
          "description": "fs.read_file 单行最大字符数（默认 2000），超出截断并标注",
          "scope": "window"
        },
        "yunxiaoAgent.toolTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "本地工具执行超时（毫秒），默认 30 秒",
          "scope": "window"
        },
        "yunxiaoAgent.alwaysAllowTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "无需审批直接放行的本地工具名列表（如 fs.write_file）；只读工具本就免审批",
          "scope": "window"
        },
        "yunxiaoAgent.scopedApprovals": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": [],
          "description": "本地工具的范围授权记录（工作区、工具、资源、有效期）；由扩展维护",
          "scope": "window"
        },
        "yunxiaoAgent.shellWhitelist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "npm test",
            "npm run lint",
            "npm run build",
            "npm run check",
            "git status",
            "git diff",
            "git log",
            "git branch",
            "node -v",
            "npm -v",
            "tsc --noEmit",
            "python -m pytest",
            "go test",
            "cargo test"
          ],
          "description": "终端自动放行的安全命令前缀列表（前缀匹配，如 npm test 匹配 npm test -- --grep foo）",
          "scope": "window"
        },
        "yunxiaoAgent.terminalTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "终端命令执行超时（毫秒），默认 5 分钟",
          "scope": "window"
        },
        "yunxiaoAgent.terminalOutputLimit": {
          "type": "number",
          "default": 10000,
          "description": "终端输出截断上限（字符），保留尾部",
          "scope": "window"
        },
        "yunxiaoAgent.toolResultLimit": {
          "type": "number",
          "default": 10000,
          "description": "所有工具结果的统一文本长度上限（字符），作为治理的字符兜底",
          "scope": "window"
        },
        "yunxiaoAgent.toolResult.maxLines": {
          "type": "number",
          "default": 2000,
          "description": "工具结果治理的最大行数（默认 2000），超出截断并标注",
          "scope": "window"
        },
        "yunxiaoAgent.toolResult.maxBytes": {
          "type": "number",
          "default": 51200,
          "description": "工具结果治理的最大字节数（默认 50KB，UTF-8），超出截断并标注",
          "scope": "window"
        },
        "yunxiaoAgent.skills.directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".vscode/skills"
          ],
          "description": "Skill 搜索目录列表（相对工作区根的路径），插件将从这些目录加载 Markdown 格式的 Skill",
          "scope": "window"
        },
        "yunxiaoAgent.sync.source": {
          "type": "string",
          "enum": [
            "none",
            "claude",
            "trae"
          ],
          "enumDescriptions": [
            "不加载任何生态配置（默认）",
            "加载 Claude 目录 SKILL（~/.claude/skills、项目 .claude/skills）并注入项目 CLAUDE.md/AGENTS.md 规范",
            "加载 Trae 目录 SKILL（~/.trae/skills、~/.trae-cn/skills 与项目对应目录）并注入项目 .trae/rules 规则"
          ],
          "default": "none",
          "description": "配置来源（二选一）：Claude 与 Trae 的 SKILL 同步与项目规则注入共用此单选，避免重复加载两套约束",
          "scope": "window"
        },
        "yunxiaoAgent.agent.maxSteps": {
          "type": "number",
          "default": 50,
          "description": "Agent Loop 最大步数（每步 = 一次 LLM 调用 + 工具执行）",
          "scope": "window"
        },
        "yunxiaoAgent.agent.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "自定义 Agent 系统提示词（留空使用默认）",
          "scope": "window"
        },
        "yunxiaoAgent.compaction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用上下文自动压缩",
          "scope": "window"
        },
        "yunxiaoAgent.compaction.keepTokens": {
          "type": "number",
          "default": 8000,
          "description": "压缩时保留的近期 token 数",
          "scope": "window"
        },
        "yunxiaoAgent.compaction.buffer": {
          "type": "number",
          "default": 20000,
          "description": "触发压缩的 buffer token 数",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "marked": "^18.0.7",
    "simple-git": "^3.27.0"
  }
}