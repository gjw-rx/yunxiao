{
  "name": "yunxiao-agent",
  "displayName": "云效 Agent",
  "publisher": "yunxiao",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunxiao/yunxiao-agent"
  },
  "description": "码力云效-对接自有ai服务",
  "version": "0.0.3",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yunxiaoAgentContainer",
          "title": "云效 Agent",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "yunxiaoAgentContainer": [
        {
          "type": "webview",
          "id": "yunxiaoAgent.chatView",
          "name": "对话",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "yunxiaoAgent.openPanel",
        "title": "云效 Agent: 打开对话面板"
      },
      {
        "command": "yunxiaoAgent.newSession",
        "title": "云效 Agent: 新建会话",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "yunxiaoAgent.newSession",
          "when": "view == yunxiaoAgent.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "云效 Agent",
      "properties": {
        "yunxiaoAgent.serviceBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8002",
          "description": "AI 服务的 Base URL（FastAPI 服务地址）",
          "scope": "window"
        },
        "yunxiaoAgent.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "fs.read_file 读取文件大小上限（字节），默认 1MB",
          "scope": "window"
        },
        "yunxiaoAgent.toolTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "本地工具执行超时（毫秒），默认 30 秒",
          "scope": "window"
        },
        "yunxiaoAgent.alwaysAllowTools": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "无需审批直接放行的本地工具名列表（如 fs.write_file）；只读工具本就免审批",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "marked": "^18.0.7"
  }
}
